# Veil Wallet — Environment Variables
# Copy to .env.local and fill in your values.
#
# Nothing here is required to run the wallet on testnet: every value below
# either has a working default compiled into lib/, or gates a feature that
# degrades cleanly when it is unset. `npm run dev` on a fresh clone works with
# this file untouched. Each entry is marked:
#
#   Required for <X>  — that feature is off or broken without it
#   Optional          — an override or a nice-to-have
#
# Anything without the NEXT_PUBLIC_ prefix is server-only and never reaches the
# browser. Keep real values in .env.local, which is gitignored. Never commit a
# secret to this file.


# ── Network ──────────────────────────────────────────────────────────────────

# Optional. Active wallet network (testnet | mainnet). Defaults to testnet.
# Only the first visit uses this; after that the user's choice in the network
# switcher is stored in localStorage and wins.
NEXT_PUBLIC_NETWORK=testnet

# Factory contract IDs. Both networks have working defaults compiled into
# lib/network.ts, so a fresh clone runs with none of these set — override only
# to point at your own factory deployment.
#
# Optional. Testnet factory contract ID.
# Kept for backwards compatibility with older local setups.
NEXT_PUBLIC_FACTORY_CONTRACT_ID=CAUK4MWO3TTFM6PLURSH2GPK3AB747SZGABKTCVLKCU7W2MGKHKP35GA

# Optional. Preferred explicit per-network factory contract IDs.
# These take precedence over NEXT_PUBLIC_FACTORY_CONTRACT_ID above.
NEXT_PUBLIC_FACTORY_CONTRACT_ID_TESTNET=CAUK4MWO3TTFM6PLURSH2GPK3AB747SZGABKTCVLKCU7W2MGKHKP35GA
NEXT_PUBLIC_FACTORY_CONTRACT_ID_MAINNET=CCZ3JLRESNLDADGXWNEH4YQ4NXUUAHRJNCWZHYG6QB4KTDYHOH6OQ7BK

# Optional testnet endpoint overrides.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Optional. Older alias for NEXT_PUBLIC_SOROBAN_RPC_URL on testnet. Read only
# when NEXT_PUBLIC_SOROBAN_RPC_URL is unset; prefer that one in new setups.
NEXT_PUBLIC_RPC_URL=


# ── Mainnet RPC ──────────────────────────────────────────────────────────────
#
# Stellar publishes no public Soroban RPC for mainnet, so mainnet needs an
# endpoint of your own from Blockdaemon, Validation Cloud, QuickNode, or a
# self-hosted node. With none of the three set, the UI keeps mainnet disabled.

# Required for mainnet (server-side, preferred). No NEXT_PUBLIC_ prefix, so the
# wallet proxies mainnet RPC through /api/rpc/mainnet and the provider key
# never reaches the browser. Use this one for anything deployed publicly.
MAINNET_RPC_URL=

# Optional. Server-side fallback, read only when MAINNET_RPC_URL is unset.
SOROBAN_MAINNET_RPC_URL=

# Required for mainnet (browser-exposed). Takes precedence over the proxy, so
# the endpoint ends up in client bundles — use it for local development only,
# never with a metered or keyed provider URL.
NEXT_PUBLIC_MAINNET_RPC_URL=


# ── WebAuthn relying party ───────────────────────────────────────────────────
#
# Both unset on web: the SDK falls back to window.location.hostname / origin.
# Native (Expo / React Native) builds have no window, so they must set these.

# Optional. WebAuthn relying party ID, e.g. "veil.app" or "localhost".
NEXT_PUBLIC_RP_ID=

# Optional. WebAuthn origin, e.g. "https://veil.app".
NEXT_PUBLIC_ORIGIN=


# ── Contract WASM hashes ─────────────────────────────────────────────────────

# Vault contract WASM hashes. Required only when creating a new vault from the
# UI. You can still attach and manage an existing vault without these.
NEXT_PUBLIC_VAULT_WASM_HASH=
NEXT_PUBLIC_VAULT_WASM_HASH_TESTNET=
NEXT_PUBLIC_VAULT_WASM_HASH_MAINNET=

# DAO multisig contract WASM hashes, per network (issue #672).
#
# A WASM hash only means something on the network the bytecode was installed
# on, so there is one variable per network and no shared fallback. Whether
# /multisig is reachable at all is decided by these: a network with no hash
# has no multisig route, because the deploy could only fail at the signature.
#
# Optional. Testnet has a verified default compiled into lib/multisigConfig.ts
# (7eb63568…, confirmed installed on testnet), so leave this blank unless you
# installed your own build.
NEXT_PUBLIC_MULTISIG_WASM_HASH_TESTNET=
# Required for /multisig on mainnet. Mainnet has NO default: the multisig
# contract is not installed on mainnet as of 2026-09-02, so /multisig is gated
# off there. Set this only after actually installing the WASM on mainnet — a
# hash that is not on-chain re-creates the exact failure #672 describes.
NEXT_PUBLIC_MULTISIG_WASM_HASH_MAINNET=


# ── Services ─────────────────────────────────────────────────────────────────

# Required for dApp connections. WalletConnect Cloud project ID.
# Get one at https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=

# Required for /agent. Agent WebSocket server.
NEXT_PUBLIC_AGENT_WS_URL=ws://localhost:3001

# Optional. Lens price-oracle base URL, used for fiat conversion.
# Defaults to the hosted deployment when unset.
NEXT_PUBLIC_LENS_URL=

# Optional. Wraith indexer base URL — the activity feed and the CAP-46 NFT
# gallery both read from it. Point it at your own deployment; leaving it blank
# is supported and the gallery will say so rather than render an empty wallet.
NEXT_PUBLIC_WRAITH_URL=

# Optional. Soroswap aggregator API key for swap routing. Without it the swap
# screen falls back to SDEX paths, which quote worse but still work.
NEXT_PUBLIC_SOROSWAP_API_KEY=

# Required for /earn and /pools. Comma-separated Blend pool contract IDs
# (C…). With none set, no pools are listed.
NEXT_PUBLIC_BLEND_POOL_IDS=

# Optional. Comma-separated SEP-24 anchor home domains for deposit and
# withdraw. Defaults to testanchor.stellar.org.
NEXT_PUBLIC_SEP24_ANCHORS=

# Optional. Transak API key for the buy-crypto fiat onramp (issue #117).
# Apply at https://partners.transak.com — free for dev/testnet usage.
# If omitted, Transak widget opens without an API key (limited mode).
NEXT_PUBLIC_TRANSAK_API_KEY=


# ── Server-only secrets ──────────────────────────────────────────────────────

# Required for sponsored trustlines. Stellar secret key (S…) of the account
# that pays the reserve when a user with no XLM adds their first trustline.
#
# SECRET. Server-only, no NEXT_PUBLIC_ prefix, and it must stay that way: this
# key is spendable, so exposing it to the browser drains the account. Keep it
# in .env.local or your host's secret store, and leave the placeholder blank
# here. Without it, /api/sponsor-trustline returns 503 and the wallet falls
# back to asking the user to fund their own account rather than failing
# mid-flow.
SPONSOR_SECRET_KEY=


# ── Diagnostics ──────────────────────────────────────────────────────────────

# Optional. Sentry DSN for error reporting. Reporting is off when unset.
NEXT_PUBLIC_SENTRY_DSN=

# Optional. Explicit opt-in for the gallery's demonstration NFTs (1 = on,
# default off). Never enable in a deployment a real user can reach: the items
# are invented.
NEXT_PUBLIC_NFT_FIXTURES=0
